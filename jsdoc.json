{
  "source": {
    "include": ["backend/src", "frontend/src"],
    "includePattern": ".+\\.(js|jsx|ts|tsx)$"
  },
  "opts": {
    "destination": "code-docs",
    "recurse": true,
    "readme": "code-docs/README.md",
    "template": "node_modules/jsdoc/templates/default"
  },
  "plugins": [],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false
  }
}