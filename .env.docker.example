# =====================================================
# CONFIGURACIÓN DE DOCKER - MINDCARE
# =====================================================
# IMPORTANTE: Copia este archivo como .env.docker y
# cambia TODOS los valores antes de usar en producción
# =====================================================

# MongoDB Configuration (CAMBIAR EN PRODUCCIÓN)
MONGO_ROOT_USER=tu_usuario_mongo
MONGO_ROOT_PASSWORD=TU_CONTRASEÑA_SUPER_SEGURA_AQUI_MIN_32_CARACTERES
MONGO_DB=mindcare

# Backend Configuration (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=TU_JWT_SECRET_AQUI_DEBE_SER_ALEATORIO_Y_MUY_LARGO_MIN_64_CARACTERES
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# =====================================================
# NOTAS DE SEGURIDAD:
# - NUNCA uses 'admin', 'admin123' o contraseñas simples
# - Genera contraseñas aleatorias: openssl rand -base64 32
# - JWT_SECRET debe tener mínimo 64 caracteres aleatorios
# - Este archivo NO debe subirse a Git
# =====================================================

# Production URLs (cambiar cuando despliegues)
# FRONTEND_URL=https://mindcare.example.com
# REACT_APP_API_URL=https://api.mindcare.example.com

