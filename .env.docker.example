# =====================================================
# CONFIGURACIÓN DE DOCKER - MINDCARE CON MONGODB ATLAS
# =====================================================
# IMPORTANTE: Copia este archivo como .env y
# cambia TODOS los valores antes de usar en producción
# =====================================================

# MongoDB Atlas Configuration
# Obtén tu connection string desde:
# MongoDB Atlas → Database → Connect → Connect your application
# Formato: mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tu_usuario:tu_contraseña@cluster0.xxxxx.mongodb.net/mindcare?retryWrites=true&w=majority

# Backend Configuration (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=TU_JWT_SECRET_AQUI_DEBE_SER_ALEATORIO_Y_MUY_LARGO_MIN_64_CARACTERES
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# =====================================================
# NOTAS DE SEGURIDAD:
# - NUNCA uses 'admin', 'admin123' o contraseñas simples
# - Genera contraseñas aleatorias: openssl rand -base64 32
# - JWT_SECRET debe tener mínimo 64 caracteres aleatorios
# - Este archivo NO debe subirse a Git
# =====================================================

# Production URLs (cambiar cuando despliegues)
# FRONTEND_URL=https://mindcare.example.com
# REACT_APP_API_URL=https://api.mindcare.example.com

